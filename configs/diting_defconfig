# DITING (Xiaomi 12T Pro, SM8475) XNU Kernel Configuration
# Based on mayfly_defconfig from hakios-xnu-kernel

# Architecture
CONFIG_ARM64=y
CONFIG_ARM=y
CONFIG_MACH_SM8475=y
CONFIG_SOC_SM8475=y

# CPU
CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_CPU_PM=y
CONFIG_CPU_IDLE=y
CONFIG_ARM_PSCI_FW=y
CONFIG_ARM_PSCI_CPUIDLE=y

# Memory
CONFIG_HIGHMEM=y
CONFIG_PHYS_OFFSET=0x80000000
CONFIG_DRAM_BASE=0x80000000
CONFIG_DRAM_SIZE=0x100000000
CONFIG_HIGHMEM_BASE=0x100000000
CONFIG_HIGHMEM_SIZE=0x200000000

# Kernel features
CONFIG_KASAN=n
CONFIG_KASAN_STACK=0
CONFIG_DEBUG_KERNEL=n
CONFIG_DEBUG_INFO=n
CONFIG_PANIC_TIMEOUT=0
CONFIG_PANIC_ON_OOPS=n
CONFIG_SOFTLOCKUP_DETECTOR=n
CONFIG_HARDLOCKUP_DETECTOR=n

# Boot
CONFIG_CMDLINE="rd=ufsroot0 ufsrw=1 rootrw=1 cpus=7 launchd_unsecure_cache=1 wdt=-1 ditingfb_noconsole=1 ditingfb_hz=30 ditingusb=2 adsp=1 sound=4 sound_sd=2 sound_below=80 sound_gain=0 speaker_sr=8 qcabt=6 wifi_pcie=12 wifi_lx=2 wifi_station=1 wifi_read_ms=0 wifi_wait_ms=10000 wifi_mac=<MAC> fb_hud=1 cpu_mhz=2400"

# Device Tree
CONFIG_OF=y
CONFIG_OF_FLATTREE=y
CONFIG_OF_EARLY_FLATTREE=y
CONFIG_OF_ADDRESS=y
CONFIG_OF_IRQ=y
CONFIG_OF_DEVICE=y
CONFIG_OF_NET=y
CONFIG_OF_MDIO=y
CONFIG_OF_PCI=y
CONFIG_OF_PLATFORM=y

# Interrupts
CONFIG_GIC_V3=y
CONFIG_GIC_V3_ITS=y
CONFIG_IRQ_DOMAIN=y
CONFIG_IRQ_DOMAIN_HIERARCHY=y

# Timers
CONFIG_ARM_ARCH_TIMER=y
CONFIG_ARM_ARCH_TIMER_EVTSTREAM=y

# IOMMU/SMMU
CONFIG_IOMMU_API=y
CONFIG_IOMMU_DMA=y
CONFIG_QCOM_IOMMU=y
CONFIG_QCOM_SMMU=y

# PCIe
CONFIG_PCI=y
CONFIG_PCI_DOMAINS=y
CONFIG_PCI_MSI=y
CONFIG_PCI_QUIRKS=y
CONFIG_PCI_QCOM=y
CONFIG_PCI_QCOM_SM8475=y

# UFS
CONFIG_SCSI=y
CONFIG_SCSI_UFS=y
CONFIG_SCSI_UFS_HPB=y
CONFIG_SCSI_UFS_QCOM=y

# USB
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_GADGET=y
CONFIG_USB_GADGET_DWC3=y
CONFIG_USB_GADGET_FASTBOOT=y

# Display
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_QCOM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_PLL=y
CONFIG_DRM_MSM_DSI_CMD_MODE=y

# GPU - Adreno 730
CONFIG_DRM_MSM_GPU=y
CONFIG_DRM_MSM_ADRENO=y
CONFIG_DRM_MSM_ADRENO_A7XX=y
CONFIG_DRM_MSM_ADRENO_GMU=y
CONFIG_DRM_MSM_ADRENO_HFI=y
CONFIG_DRM_MSM_ADRENO_ZAP_SHADER=y

# Touch (Goodix GT9916S on SPI)
CONFIG_INPUT=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_GOODIX=y
CONFIG_TOUCHSCREEN_GOODIX_SPI=y

# GPIO Keys
CONFIG_INPUT_GPIO_KEYS=y
CONFIG_INPUT_PMIC_PWRKEY=y

# SPI
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_QCOM_GENI=y

# SPMI
CONFIG_SPM=y
CONFIG_SPM_PMIC=y
CONFIG_QCOM_SPM=y
CONFIG_QCOM_PMIC=y
CONFIG_QCOM_PMK8350=y

# Audio DSP
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_QCOM=y
CONFIG_SND_SOC_WAIPIO=y
CONFIG_SND_SOC_WAIPU_MTP=y

# Bluetooth (QCA6490)
CONFIG_BT=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_BT_QCA=y
CONFIG_BT_QCA_ROME=y

# Wi-Fi (QCA6490 via PCIe + ath11k)
CONFIG_WLAN=y
CONFIG_ATH11K=y
CONFIG_ATH11K_PCI=y
CONFIG_ATH11K_AHB=n
CONFIG_ATH11K_SPECTRAL=n

# Crypto
CONFIG_CRYPTO=y
CONFIG_CRYPTO_AES_ARM64=y
CONFIG_CRYPTO_SHA256_ARM64=y
CONFIG_CRYPTO_SHA512_ARM64=y
CONFIG_CRYPTO_GHASH_ARM64=y

# Filesystems
CONFIG_HFS=y
CONFIG_HFSPLUS=y
CONFIG_APFS_FS=y
CONFIG_FUSE_FS=y

# Network
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_PACKET=y

# Security (disabled for iOS port)
CONFIG_SECURITY=n
CONFIG_SECURITY_NETWORK=n
CONFIG_SECURITY_PATH=n
CONFIG_INTEGRITY=n
CONFIG_IMA=n

# AMFI / Sandbox (disabled)
CONFIG_MACF=n
CONFIG_AMFI=n

# Debug
CONFIG_EARLY_PRINTK=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y

# XNU specific
CONFIG_XNU=y
CONFIG_XNU_KERNEL=y
CONFIG_XNU_BSD=y
CONFIG_XNU_MACH=y
CONFIG_XNU_IOKIT=y
CONFIG_XNU_DRIVERS=y

# iOS userland compatibility
CONFIG_IOS_USERLAND=y
CONFIG_IOS_VERSION=160500  # 16.5
CONFIG_DARWIN_USERLAND=y

# HakiOS specific
CONFIG_HAKIOS=y
CONFIG_HAKIOS_DITING=y
CONFIG_HAKIOS_ADRENO7=y
CONFIG_HAKIOS_QCA6490=y
CONFIG_HAKIOS_WAIPU_MTP=y
CONFIG_HAKIOS_GT9916S=y

# Boot args defaults
CONFIG_BOOT_ARGS_DEFAULT="rd=ufsroot0 ufsrw=1 rootrw=1 cpus=7 launchd_unsecure_cache=1 wdt=-1 ditingfb_noconsole=1 ditingfb_hz=30 ditingusb=2 adsp=1 sound=4 sound_sd=2 sound_below=80 sound_gain=0 speaker_sr=8 qcabt=6 wifi_pcie=12 wifi_lx=2 wifi_station=1 wifi_read_ms=0 wifi_wait_ms=10000 fb_hud=1 cpu_mhz=2400"